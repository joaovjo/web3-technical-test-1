# ============================================
# Configuração do Projeto 1: BSC Balance Query
# ============================================

# URL do nó RPC da Binance Smart Chain
#
# Opções públicas:
#
# - https://bsc-dataseed.binance.org/ (oficial Binance)
# - https://bsc-dataseed1.defibit.io/
# - https://bsc-dataseed1.ninicoin.io/
#
RPC_URL=https://bsc-dataseed.binance.org/
RPC_URL_BACKUP=https://bsc-dataseed1.defibit.io/

# Endereço da wallet para consultar saldo
# Exemplo: wallet Binance conhecida (opcional, pode usar qualquer endereço)
# Formato: 0x + 40 caracteres hexadecimais (com ou sem 0x, será normalizado)
#
# Opções de Wallets:
#
# - Binance Hot Wallet 8 = 0xF977814e90dA44bFA03b6295A0616a897441aceC
# - Binance 14 = 0x28C6c06298d514Db089934071355E5743bf21d60
# - Binance 7 = 0x3f5CE5FBFe3E9af3971dD833D26bA9b5C936f0bE
# - Binance Peg Tokens = 0x8894E0a0c962CB723c1976a4421c95949bE2D4E3
WALLET_ADDRESS=0xF977814e90dA44bFA03b6295A0616a897441aceC

# Opções de Tokens:
#
# - USDT = 0x55d398326f99059fF775485246999027B3197955
# - BUSD = 0xe9e7CEA3DedcA5984780Bafc599bD69ADd087D56
# - CAKE = 0x0E09FaBB73Bd3Ade0a17ECC321fD13a19e81cE82
# - WBNB = 0xbb4CdB9CBd36B01bD1cBaEBF2De08d9173bc095c
#
# Endereço do contrato USDT (BEP-20) na BSC
# Este é o contrato oficial USDT Binance Smart Chain
# Não mude a menos que queira consultar outro token
USDT_CONTRACT=0x55d398326f99059fF775485246999027B3197955
